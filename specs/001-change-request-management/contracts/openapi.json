{
  "openapi": "3.1.0",
  "info": {
    "title": "قرارداد API مدیریت درخواست تغییر ChangeFlow",
    "version": "1.0.0",
    "description": "خروجی طراحی Plan؛ وجود پیاده‌سازی یا اجرای آزمون ادعا نمی‌شود. قرارداد تکمیلی http-api.md و ترتیب محرمانگی و Unicode آن الزام‌آورند."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "نشانی برنامه‌ریزی‌شده برای اجرای محلی آینده؛ در این مرحله سرویسی راه‌اندازی نشده است."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "change-requests",
      "description": "عملیات مصوب درخواست تغییر"
    }
  ],
  "paths": {
    "/api/change-requests": {
      "post": {
        "tags": [
          "change-requests"
        ],
        "operationId": "createChangeRequest",
        "summary": "ایجاد پیش‌نویس",
        "description": "Requester فعلی؛ مالک از هویت معتبر و وضعیت Draft از سامانه تعیین می‌شوند. تکرار معتبر، درخواست مستقلی می‌سازد. JWT معتبر بدون نگاشت محلی مجوز ایجاد ندارد و 403 می‌گیرد؛ کاربر یا نقش خودکار ساخته نمی‌شود.",
        "requestBody": {
          "required": true,
          "description": "فقط سه مقدار محتوایی؛ سایر خصوصیت‌ها از جمله requesterId و status باعث رد کل عملیات‌اند. سقف بدنهٔ خام ۱۳۱۰۷۲ بایت است؛ عبور از آن پیش از parsing و بررسی هویت/visibility با 413 عمومی رد می‌شود.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteChangeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Response201_1"
          },
          "400": {
            "$ref": "#/components/responses/Response400_2"
          },
          "401": {
            "$ref": "#/components/responses/Response401_3"
          },
          "403": {
            "$ref": "#/components/responses/Response403_4"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/Response500_5"
          },
          "503": {
            "$ref": "#/components/responses/Response503_6"
          }
        }
      }
    },
    "/api/change-requests/{id}": {
      "get": {
        "tags": [
          "change-requests"
        ],
        "operationId": "getChangeRequest",
        "summary": "مشاهدهٔ درخواست مجاز",
        "description": "مالک در همهٔ وضعیت‌ها و Reviewer برای درخواست دیگران فقط در PendingReview؛ پاسخ منبع پنهان و ناموجود یکسان است. JWT معتبر بدون نگاشت محلی همان پاسخ عمومی 404 را می‌گیرد؛ شکست Database با نبود نگاشت یکی نیست.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "شناسهٔ UUID درخواست؛ برای شناسهٔ ناموجود، نامعتبر یا خارج از دسترسی، پاسخ عمومی 404 است.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Response200_7"
          },
          "400": {
            "$ref": "#/components/responses/Response400_2"
          },
          "401": {
            "$ref": "#/components/responses/Response401_3"
          },
          "404": {
            "$ref": "#/components/responses/Response404_8"
          },
          "500": {
            "$ref": "#/components/responses/Response500_5"
          },
          "503": {
            "$ref": "#/components/responses/Response503_6"
          }
        }
      },
      "put": {
        "tags": [
          "change-requests"
        ],
        "operationId": "updateChangeRequest",
        "summary": "جایگزینی محتوای درخواست",
        "description": "هر سه مقدار لازم‌اند؛ فقط مالک دارای مجوز Requester در Draft یا ChangesRequested. نوشتن مشروط به نسخهٔ مشاهده‌شده و تراکنش است. JWT معتبر بدون نگاشت محلی همان پاسخ عمومی 404 را می‌گیرد؛ شکست Database با نبود نگاشت یکی نیست.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "شناسهٔ UUID درخواست؛ برای شناسهٔ ناموجود، نامعتبر یا خارج از دسترسی، پاسخ عمومی 404 است.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "یک ETag قوی از آخرین نمایش مشاهده‌شده؛ wildcard، چند مقدار و نسخهٔ ضعیف مجاز نیستند. تقدم بررسی‌ها در http-api.md الزام‌آور است.",
            "schema": {
              "type": "string",
              "pattern": "^\"cf-[0-9a-f-]{36}-[0-9a-f-]{36}\"$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "فقط سه مقدار محتوایی؛ سایر خصوصیت‌ها از جمله requesterId و status باعث رد کل عملیات‌اند. سقف بدنهٔ خام ۱۳۱۰۷۲ بایت است؛ عبور از آن پیش از parsing و بررسی هویت/visibility با 413 عمومی رد می‌شود.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteChangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Response200_7"
          },
          "400": {
            "$ref": "#/components/responses/Response400_2"
          },
          "401": {
            "$ref": "#/components/responses/Response401_3"
          },
          "403": {
            "$ref": "#/components/responses/Response403_4"
          },
          "404": {
            "$ref": "#/components/responses/Response404_8"
          },
          "409": {
            "$ref": "#/components/responses/Response409_9"
          },
          "412": {
            "$ref": "#/components/responses/Response412_10"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "428": {
            "$ref": "#/components/responses/Response428_11"
          },
          "500": {
            "$ref": "#/components/responses/Response500_5"
          },
          "503": {
            "$ref": "#/components/responses/Response503_6"
          }
        }
      }
    },
