  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "توکن امضاشدهٔ محلی Development/Test با issuer و audience مشخص؛ مجوز فعلی از SQLite خوانده می‌شود."
      }
    },
    "schemas": {
      "WriteChangeRequest": {
        "type": "object",
        "description": "این Schema ساختار ورودی خام را توصیف می‌کند؛ پذیرش ساختاری آن کافی نیست. اعتبارسنجی معنایی باید متن سادهٔ well-formed Unicode، مقدار غیرخالی و حدود طول را پس از trim و بر حسب Unicode scalar بررسی و مقدار trim‌شده را ثبت کند؛ حدود بالای طول روی رشتهٔ خام اعمال نمی‌شوند. تبدیل خودکار نوع و حذف بی‌صدای خصوصیت اضافی مجاز نیست.",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "reason"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "عنوان باید متن سادهٔ Unicode باشد. پس از حذف فاصله‌های ابتدا و انتها، طول آن باید بین ۱ تا ۲۰۰ Unicode scalar باشد و همان مقدار ثبت شود. این قاعده در اعتبارسنجی معنایی اعمال می‌شود؛ محدودیت طول روی رشتهٔ خام اعمال نمی‌شود."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "شرح تغییر باید متن سادهٔ Unicode و بدون تفسیر HTML یا Markdown باشد. پس از حذف فاصله‌های ابتدا و انتها، طول آن باید بین ۱ تا ۵۰۰۰ Unicode scalar باشد و همان مقدار ثبت شود. این قاعده در اعتبارسنجی معنایی اعمال می‌شود؛ محدودیت طول روی رشتهٔ خام اعمال نمی‌شود."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "دلیل تغییر باید متن سادهٔ Unicode باشد؛ فارسی، لاتین، نیم‌فاصله و ایموجی مجازند. پس از حذف فاصله‌های ابتدا و انتها، طول آن باید بین ۱ تا ۲۰۰۰ Unicode scalar باشد و همان مقدار ثبت شود. این قاعده در اعتبارسنجی معنایی اعمال می‌شود؛ محدودیت طول روی رشتهٔ خام اعمال نمی‌شود."
          }
        }
      },
      "ChangeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "reason",
          "requesterId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "شناسهٔ سامانه"
          },
          "title": {
            "type": "string",
            "description": "عنوان ثبت‌شده پس از trim"
          },
          "description": {
            "type": "string",
            "description": "شرح ثبت‌شده"
          },
          "reason": {
            "type": "string",
            "description": "دلیل ثبت‌شده"
          },
          "requesterId": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "description": "شناسهٔ ثبت‌کننده؛ در ورودی ممنوع است."
          },
          "status": {
            "type": "string",
            "readOnly": true,
            "enum": [
              "Draft",
              "PendingReview",
              "ChangesRequested",
              "Approved"
            ],
            "description": "وضعیت تحت کنترل گردش کار؛ در ورودی محتوایی ممنوع است."
          }
        }
      },
      "EmptyAction": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0,
        "description": "شیء خالی؛ دلیل بررسی یا تغییر فیلدها جزو این عملیات نیست."
      },
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "نام فنی فیلد یا پیش‌شرط"
          },
          "reason": {
            "type": "string",
            "description": "علت کوتاه فارسی"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "category",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHENTICATED",
              "REQUEST_UNAVAILABLE",
              "FORBIDDEN",
              "INVALID_INPUT",
              "INVALID_STATE",
              "CONCURRENCY_CONFLICT",
              "VERSION_REQUIRED",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR",
              "PAYLOAD_TOO_LARGE"
            ],
            "description": "شناسهٔ فنی خطا"
          },
          "category": {
            "type": "string",
            "enum": [
              "هویت نامعتبر",
              "درخواست در دسترس نیست",
              "مجوز ناکافی برای درخواست قابل مشاهده",
              "ورودی نامعتبر",
              "وضعیت نامعتبر",
              "تعارض هم‌زمان",
              "خطای فنی"
